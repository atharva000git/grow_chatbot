# Copy to .env and fill in. .env is gitignored; never commit a real key.
#
# Required for factual answers. The app starts and the guards work without it,
# but factual questions then show a "Generation unavailable" banner.
LLM_API_KEY=

# Optional. Defaults to gpt-4o-mini when empty.
LLM_MODEL=

# Optional. Any OpenAI-compatible base URL, e.g.
#   Groq        https://api.groq.com/openai/v1
#   Together    https://api.together.xyz/v1
#   OpenRouter  https://openrouter.ai/api/v1
# Empty means OpenAI, and the key must then be an OpenAI key.
LLM_BASE_URL=
